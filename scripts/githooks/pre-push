#!/usr/bin/env bash
# Fail push when site-related commits introduce broken internal links.
set -euo pipefail

remote="${1:-}"
url="${2:-}"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

site_paths_re='^(site/|library/|roster/|models/|\.github/workflows/library-site)'

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
needs_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git diff --name-only "$range" | grep -Eq "$site_paths_re"; then
    needs_check=1
    break
  fi
done

if [[ "$needs_check" -eq 0 ]]; then
  exit 0
fi

echo "pre-push: site-related changes detected; running make -C site check-links"
echo "pre-push: remote=${remote:-?} url=${url:-?}"
make -C site check-links
